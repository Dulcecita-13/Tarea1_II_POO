namespace TareaPOO
{
    public class Ejercicio11
    {
        public Ejercicio11()
        {
            /*Positivo, negativo o cero - Solicitar un número entero e indicar si es positivo,
             negativo o cero. Además, usando el operador ternario, mostrar si el
              número es par o impar.*/

            Console.WriteLine("Ingrese un número entero:");
            int.TryParse(Console.ReadLine(), out int numero);

            if (numero > 0)
                {
                    Console.WriteLine("El número es positivo.");
                }
                    else 
                    {
                        if (numero < 0)
                        {
                            Console.WriteLine("El número es negativo.");
                        }
                            else
                            {
                                Console.WriteLine("El número es cero.");
                            }
                    }

            string paronopar= (numero % 2 == 0) ? "par" : "impar";
            Console.WriteLine($"El num es {paronopar}.");



        }
    }
}