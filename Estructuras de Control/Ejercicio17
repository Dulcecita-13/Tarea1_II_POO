namespace TareaPOO
{
    public class Ejercicio17
    {
        public Ejercicio17()
        {
            /*17. Calculadora de descuentos - Según el monto de compra 
            aplicar descuentos escalonados: 5% (L500-999), 10% (L1000-2499), 
            15% (L2500+). Mostrar precio original, descuento y precio final.*/

            Console.WriteLine("Ingrese el monto de compra:");
            double.TryParse(Console.ReadLine(), out double monto);

            if (monto<500)
            {
                Console.WriteLine("No hay descuento para montos menores a L500.");
                Console.WriteLine($"Precio original: L{monto}, Descuento: L0, Precio final: L{monto}");
            }
            else
            {
                double descuento = 0;

                if (monto>=500&&monto<=999)
                {
                    descuento = monto * 0.05;
                }
                else if (monto >= 1000 && monto <= 2499)
                {
                    descuento = monto * 0.10;
                }
                else if (monto >= 2500)
                {
                    descuento = monto * 0.15;
                }

                double precioFinal = monto - descuento;

                Console.WriteLine($"Precio original: L{monto}, Descuento: L{descuento}, Precio final: L{precioFinal}");
            }
        }
    }
}