namespace TareaPOO
{
    public class Ejercicio14
    {
        public Ejercicio14()
        {
            /*Calculadora con switch - Mostrar un menú con las operaciones +, -, *, / y %. Validar la división y
el módulo entre cero mostrando un mensaje de error.*/

            Console.WriteLine("Ingresar el primer número:");
            double.TryParse(Console.ReadLine(), out double numero1);

            Console.WriteLine("Ingresar un segundo número:");
            double.TryParse(Console.ReadLine(), out double numero2);

            Console.WriteLine("Seleccione la operación que desea realizar:");
            Console.WriteLine("1. Suma (+)");
            Console.WriteLine("2. Resta (-)");
            Console.WriteLine("3. Multiplicación (*)");
            Console.WriteLine("4. División (/)");
            Console.WriteLine("5. Módulo (%)");

            int.TryParse(Console.ReadLine(), out int opcion);

            switch (opcion)
            {
                case 1:
                    Console.WriteLine($"Resultado: {numero1 +numero2}");
                    break;
                case 2:
                    Console.WriteLine($"Resultado: {numero1-numero2}");
                    break;
                case 3:
                    Console.WriteLine($"Resultado: {numero1*numero2}");
                    break;
                case 4:
                    if (numero2==0)
                    {
                        Console.WriteLine("No se puede dividir entre cero.");
                    }
                    else
                    {
                        Console.WriteLine($"Resultado: {numero1 / numero2}");
                    }
                    break;
                case 5:
                    if (numero2 == 0)
                    {
                        Console.WriteLine("Error: No se puede calcular el módulo entre cero.");
                    }
                    else
                    {
                        Console.WriteLine($"Resultado: {numero1 % numero2}");
                    }
                    break;
                default:
                    Console.WriteLine("Opción no válida. Por favor, seleccione una opción del 1 al 5.");
                    break;
            }
        }
        
    }
}