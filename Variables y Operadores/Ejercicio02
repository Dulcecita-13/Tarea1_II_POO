namespace TareaPOO
{
    public class Ejercicio02
    {
        public Ejercicio02()
        {
            /*Calculadora de IMC - Solicitar peso (kg) 
        y altura (m), calcular el índice de masa corporal 
        y mostrar en qué categoría se encuentra (bajo peso, normal, sobrepeso, obesidad).*/

        Console.WriteLine("Ingrese su peso en kilogramos: ");
        double.TryParse(Console.ReadLine(), out double peso);
        Console.WriteLine("Ingrese su altura en metros: ");
        double.TryParse(Console.ReadLine(),out double altura);
        double imc=peso/(altura*altura);
        Console.WriteLine($"Su indice de masa corporal es: {imc:F2}");

        if (imc<18.5)
            {
                Console.WriteLine("Usted tiene un peso bajo.");
            }
            else
            {
                if(imc<24.5)
                {
                    Console.WriteLine("Usted tiene un peso normal.");
                }
                else
                {
                    if(imc<29.9)
                    {
                        Console.WriteLine("Usted tiene sobrepeso.");
                    }
                    else
                    {
                        Console.WriteLine("Usted tiene obesidad.");
                    }
                }
            }
        }
    }
}