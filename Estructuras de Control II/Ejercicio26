namespace TareaPOO
{
public class Ejercicio26
{
    public Ejercicio26()
        {
            /*26. Potencia con ciclo - Calcular la base elevada al exponente usando un ciclo (sin Math.Pow).
Considerar exponente 0 y exponentes negativos (resultado con decimales).*/

            Console.WriteLine("Ingrese la base:");
            double.TryParse(Console.ReadLine(), out double baseNum);

            Console.WriteLine("Ingrese el exponente:");
            int.TryParse(Console.ReadLine(), out int exponente);

            double resultado = 1;

            if (exponente == 0)
            {
                resultado = 1;
            }
            else if (exponente > 0)
            {
                for (int i = 0; i < exponente; i++)
                {
                    resultado *= baseNum;
                }
            }
            else
            {
                for (int i = 0; i < -exponente; i++)
                {
                    resultado *= baseNum;
                }
                resultado = 1 / resultado;
            }

            Console.WriteLine($"{baseNum} elevado a {exponente} es: {resultado}");
        }
}
}