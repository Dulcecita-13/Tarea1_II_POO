namespace TareaPOO
{
    public class Ejercicio23
    {
        public Ejercicio23()
        {
            /*23. Tabla de multiplicar extendida - Solicitar un 
            número y mostrar su tabla del 1 al 12 con formato alineado.*/

            Console.WriteLine("Ingrese un número para mostrar su tabla de multiplicar del 1 al 12:");
            int.TryParse(Console.ReadLine(), out int numero);

            Console.WriteLine($"Tabla de multiplicar del {numero}:");
            for (int i = 1; i <= 12; i++)
            {
                int resultado = numero * i;
                Console.WriteLine($"{numero} x {i,2} = {resultado,3}");
            }

    

            
        }

    }
}