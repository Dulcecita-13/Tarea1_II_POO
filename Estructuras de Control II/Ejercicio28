namespace TareaPOO
{
    public class Ejercicio28
    {
        public Ejercicio28()
        {
            /*28. Decimal a binario - Convertir un número entero positivo a binario usando divisiones sucesivas
entre 2 dentro de un ciclo.*/

            Console.WriteLine("Ingrese un número entero positivo para convertirlo a binario:");
            int.TryParse(Console.ReadLine(), out int numero);

            if (numero < 0)
                {
                    Console.WriteLine("Por favor, ingrese un número entero positivo.");
                    return;
                }

            string binario = string.Empty;

            do
            {
                int residuo = numero % 2;
                binario = residuo + binario;
                numero /= 2;
            } while (numero > 0);

            Console.WriteLine($"El número en binario es: {binario}");
        }
    }
}